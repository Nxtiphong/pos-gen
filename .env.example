# Firebase web app config (Firebase console > Project settings > Your apps). Public by design.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# "1" connects the client SDK to the local emulators instead of the project above.
NEXT_PUBLIC_USE_EMULATORS=
# Host the browser uses to reach the emulators. Defaults to 127.0.0.1.
NEXT_PUBLIC_EMULATOR_HOST=

# Server only (route handlers, seed). Service account from Project settings > Service accounts.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the PEM on one line with literal \n between lines.
FIREBASE_PRIVATE_KEY=

# Set these to point firebase-admin at the emulators; leave empty in production.
FIRESTORE_EMULATOR_HOST=
FIREBASE_AUTH_EMULATOR_HOST=

# Password for staff@pos.local created by `npm run seed`.
SEED_STAFF_PASSWORD=
