rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Staff is a custom claim set by `npm run seed`, so an account self-registered with the public API key is not staff.
    function isStaff() {
      return request.auth != null && request.auth.token.staff == true;
    }

    match /categories/{id} {
      allow read, write: if isStaff();
    }

    match /products/{id} {
      allow read, write: if isStaff();
    }

    match /counters/{businessDate} {
      allow read, write: if isStaff();
    }

    match /orders/{id} {
      allow read, write: if isStaff();
    }

    // The bill id is the unguessable public token, so a customer may fetch one by id but never enumerate them.
    match /bills/{publicToken} {
      allow get: if true;
      allow list, write: if isStaff();
    }

    match /queues/{businessDate} {
      allow get: if true;
      allow list, write: if isStaff();
    }
  }
}
